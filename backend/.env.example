# Flask
SECRET_KEY=change-me-in-production
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Database
DATABASE_URL=postgresql+psycopg2://your-user@/fraud_detection_db

# Africa's Talking credentials (sandbox)
AT_USERNAME=sandbox
AT_API_KEY=atsk_your-sandbox-key
# Optional sender ID. Leave blank in sandbox so delivery succeeds without a registered 'from'.
AT_SENDER_ID=
AT_VOICE_FROM=+254711082000

# Africa's Talking endpoints (sandbox)
AT_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging
AT_VOICE_URL=https://voice.sandbox.africastalking.com/call
# Sandbox voice often has no reachable host -> simulate delivery (set to false in prod)
AT_SIMULATE_VOICE_ON_UNAVAILABLE=true

# App behaviour
JWT_EXPIRATION_HOURS=24
COUNTRY_CODE=254
DEFAULT_NOTIFY_LEVEL=HIGH
